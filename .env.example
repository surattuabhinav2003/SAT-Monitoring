# ===========================================================================
# SAT Monitoring — environment configuration
#
# Copy this file to ".env" and fill in the values. ".env" is gitignored and
# must never be committed.
# ===========================================================================

# --- Database (read by docker-compose for both the db and api services) -----
POSTGRES_DB=sat_monitoring
POSTGRES_USER=sat
POSTGRES_PASSWORD=change_me_locally

# --- API --------------------------------------------------------------------
# Origins allowed to call the API (comma-separated). Add the deployed frontend
# URL here in production.
CORS_ORIGINS=http://localhost:5180

# The first admin. Inserted once on boot so somebody can grant access to
# others; if this is blank, no admin exists and nobody can grant access.
SEED_ADMIN_EMAIL=your.name@cloudfuze.com

# Restrict who may be granted admin access (comma-separated domains).
# Leave blank to accept any valid email address.
ADMIN_ALLOWED_DOMAINS=

# --- API authentication (Azure AD) ------------------------------------------
# The API verifies every bearer token against this tenant's JWKS and requires
# the audience to match this client id. Both are REQUIRED unless
# DEV_AUTH_BYPASS=true below.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Local-only escape hatch: skip token verification so the API can run without
# an Azure tenant. Every request is then treated as DEV_AUTH_EMAIL.
#
#   *** MUST be false in any shared, staging or production environment. ***
#
# It is force-disabled when NODE_ENV=production, and the API logs a loud
# warning on every boot while it is on.
DEV_AUTH_BYPASS=false
DEV_AUTH_EMAIL=

# --- Docker discovery -------------------------------------------------------
# Applications are discovered from LOCAL Docker containers — no SSH, no remote
# host, no credentials.
#
# Only the WORKER gets the Docker socket. The API has no Docker privileges and
# requests scans from the worker over a Postgres NOTIFY channel.
DISCOVERY_CRON=*/5 * * * *
DISCOVERY_URL_SCHEME=https

# URL resolution order — discovery NEVER guesses a hostname:
#   1. `sat.url` label on the container
#   2. nginx server_name / proxy_pass (set NGINX_CONF_HOST_DIR below)
#   3. neither -> the application is flagged "Needs Mapping" for an admin
#
# Host directory holding the nginx vhosts, mounted read-only into the worker.
# Defaults to the empty ./nginx-conf, which disables nginx resolution.
#   NGINX_CONF_HOST_DIR=/etc/nginx/sites-enabled
NGINX_CONF_HOST_DIR=./nginx-conf

# Container names, compose services or projects to skip (comma-separated). This
# OVERRIDES a sat.url/sat.name label, unlike the built-in list below.
DISCOVERY_EXCLUDE=

# Built-in infrastructure exclusions (postgres, mongo, redis, nginx, traefik,
# worker, sat-api, sat-db, mongo-express, …) matched on name, service and image.
# A sat.url/sat.name label overrides these. Set false to rely only on
# DISCOVERY_EXCLUDE above.
DISCOVERY_EXCLUDE_DEFAULTS=true

# Who may trigger a discovery pass on demand (the "Run Discovery" button).
# Comma-separated email addresses; each must ALSO be an admin.
# Blank = any admin, so a missing value cannot lock everyone out.
# This restricts the MANUAL trigger only — the scheduled pass always runs.
DISCOVERY_OPERATORS=

# Optional per-container labels, for reference:
#   sat.url=tool.example.com   explicit URL, and marks the container as its own
#                              application rather than part of its compose project
#   sat.name=Nice Tool Name    display name override
#   sat.ignore=true            never inventory this container

# --- Frontend (Vite) --------------------------------------------------------
# Leave unset in local dev: the Vite dev server proxies /api to the backend.
# Set this only when the frontend is served from a different origin than the API.
# VITE_API_BASE_URL=https://sat-api.cloudfuze.com/api

# Real Microsoft sign-in. While VITE_AZURE_CLIENT_ID is unset the app runs in
# demo mode and simulates the Microsoft popup — application data still comes
# from Postgres either way.
#
# Register the app as a SINGLE-PAGE APPLICATION (not "Web") in Entra ID, with
# VITE_AZURE_REDIRECT_URI as an SPA redirect URI. See docs/AZURE-SETUP.md.
VITE_AZURE_CLIENT_ID=YOUR_AZURE_CLIENT_ID
VITE_AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID
VITE_AZURE_REDIRECT_URI=http://localhost:5180

# The API scope exposed by the app registration. Defaults to
# api://<VITE_AZURE_CLIENT_ID>/access_as_user, so it only needs setting if the
# scope was exposed under a different name or Application ID URI.
# VITE_API_SCOPE=
